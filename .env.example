# RealEstateBackend — Docker Compose and local development
# Copy to .env (gitignored):  copy .env.example .env
#
# Docker Compose reads .env; Maven does NOT — export SPRING_DATASOURCE_* before host mvn test.
# See docs/04-development/LOCAL_ENV.md
#
# Compose project name: re (see compose.yaml `name:`)
# Required by Compose fail-fast (${VAR:?...}): POSTGRES_*, JWT_SECRET,
# and when using profiles: JWT_SECRET_TEST (test), PGADMIN_* (tools).

# --- Docker Compose (postgres container bootstrap) ---
POSTGRES_DB=real_estate_db
POSTGRES_USER=db_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5433

# --- API container (service `api`, profile docker) ---
# Host port 8081 avoids common conflicts with a host JVM on 8080.
BACKEND_PORT=8081
# JWT signing for development API (container + host localhost). NOT for integration tests.
JWT_SECRET=replace_with_base64_secret_min_32_bytes

# --- pgAdmin (profile tools) — required when starting that profile ---
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@local.dev
# If a password contains `$`, wrap the value in single quotes so Compose does not interpolate it.
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_only

# --- Integration-test runner (profile test) — dedicated JWT, never reuse JWT_SECRET ---
JWT_SECRET_TEST=replace_with_integration_test_base64_secret

# --- Canonical Spring contract (host JVM — profile localhost) ---
SPRING_PROFILES_ACTIVE=localhost
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/real_estate_db
SPRING_DATASOURCE_USERNAME=db_user
SPRING_DATASOURCE_PASSWORD=change_me_local_only

# --- Host integration tests (profile test) — export before mvn test ---
# SPRING_PROFILES_ACTIVE=test
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/real_estate_test_db
# SPRING_DATASOURCE_USERNAME=db_user
# SPRING_DATASOURCE_PASSWORD=change_me_local_only
# JWT_SECRET=<same value as JWT_SECRET_TEST when running tests manually>
