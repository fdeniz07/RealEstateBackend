# Local PostgreSQL for RealEstateBackend (Docker Compose)
# Copy to .env (gitignored):  copy .env.example .env
#
# Docker Compose reads .env; Maven does NOT — export SPRING_DATASOURCE_* before mvn test.
# See docs/04-development/LOCAL_ENV.md

# --- Docker Compose (postgres container bootstrap) ---
POSTGRES_DB=real_estate_db
POSTGRES_USER=db_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5433

# --- Canonical Spring contract (development — profile localhost) ---
SPRING_PROFILES_ACTIVE=localhost
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/real_estate_db
SPRING_DATASOURCE_USERNAME=db_user
SPRING_DATASOURCE_PASSWORD=change_me_local_only

# --- Canonical Spring contract (local tests — profile test) ---
# Requires real_estate_test_db (see docs/04-development/LOCAL_ENV.md §5).
# Export before mvn test (Maven does not read this file). Use a dedicated test JWT, not production.
# SPRING_PROFILES_ACTIVE=test
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/real_estate_test_db
# SPRING_DATASOURCE_USERNAME=db_user
# SPRING_DATASOURCE_PASSWORD=change_me_local_only
# JWT_SECRET=replace_with_integration_test_base64_secret

# JWT for profile localhost / spring-boot:run (development — separate from integration-test JWT)
JWT_SECRET=replace_with_base64_secret